# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only webhook administration key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Market Data Provider Keys (Server-side only)
FINNHUB_API_KEY=your-finnhub-api-key
COINGECKO_DEMO_API_KEY=your-coingecko-demo-key
TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Subscription billing (server-side secret must never be exposed)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_ANNUAL_PLAN_CODE=

# Connected brokerage (server-side only)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Live brokerage architecture. Keep disabled in production until explicitly approved.
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
LIVE_TRADING_ENABLED=false
LIVE_TRADING_MODE=sandbox
